# Copie para .env.local e preencha.
#
# Chat de atendimento (/api/chat). Ordem de uso:
#   1. Gemini, plano GRATUITO do Google AI Studio (aistudio.google.com → Get API key)
#   2. Claude, opcional (console.anthropic.com → API Keys)
#   3. nenhuma chave → o chat responde com o script offline
# Atenção: no plano gratuito o Google pode usar as conversas para melhorar os
# produtos dele. Para dados de clientes sensíveis, use o plano pago.
GEMINI_API_KEY=
# modelo principal (cai para gemini-3.6-flash se demorar ou a cota acabar)
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
# modelo do Claude (padrão claude-sonnet-5-5)
ANTHROPIC_MODEL=
# CHAT_PROVIDER=claude coloca o Claude como PRIMEIRO provedor (precisa da chave
# acima); o Gemini vira reserva. Vazio = Gemini primeiro, Claude de reserva.
CHAT_PROVIDER=

# E-mail do briefing (/briefing). Caixa da Hostinger: hPanel → E-mails →
# contato@linkandodesign.com. A senha é a da caixa de e-mail.
# Todo envio sai com assunto "[Site] …", que o filtro do webmail usa para
# mover a mensagem para a pasta "Site".
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@linkandodesign.com
SMTP_PASS=
# destino do briefing (padrão: o próprio SMTP_USER)
MAIL_TO=contato@linkandodesign.com
# cópias de todo e-mail do site (padrão: linkandodesign@gmail.com,carlosnetolima@gmail.com)
MAIL_COPIES=

# Base interna de valores, em JSON: qualifica o lead (no chat, sem número nenhum) e dá a
# faixa das três opções da pré-proposta do e-mail interno. Nunca exibida ao visitante.
# Valores reais ficam só no .env.local e nas variáveis da Vercel: o repositório é público.
# min = opção Essencial (é contra ele que o investimento declarado é comparado); max = teto.
# siteAdvanced (3D, efeitos pesados ou vários idiomas) substitui site/redesign quando o
# escopo pede; naming soma à marca quando o nome ainda vai ser criado.
# PRICING_BASE={"floor":0,"eurFactor":0,"min":{"brand":0,"identity":0,"site":0,"landing":0,"siteRedesign":0,"system":0,"siteAdvanced":0,"naming":0},"max":{"brand":0,"identity":0,"site":0,"landing":0,"siteRedesign":0,"system":0,"siteAdvanced":0,"naming":0}}

# Pré-proposta do e-mail interno (o cliente não recebe nada automático).
# PRICE_FLOOR: piso absoluto de qualquer opção, em R$. Vale o maior entre ele e o mínimo do serviço no PRICING_BASE.
PRICE_FLOOR=
PROPOSAL_VALIDITY_DAYS=
HOURLY_MIN=
HOURLY_MAX=
URGENCY_MIN=
URGENCY_MAX=
URGENCY_DEFAULT=
PAYMENT_SMALL_UPTO=
PAYMENT_SMALL=
PAYMENT_LARGE=
PIX_DISCOUNT_PCT=
CARD_NO_INTEREST=
CARD_WITH_INTEREST=
REVISION_ROUNDS=

# Teste do e-mail do lead sem enviar nada: LEAD_DRY_RUN=1 faz /api/chat/lead gravar o
# e-mail (.txt e .html) em LEAD_DRY_RUN_DIR (padrão: pasta temporária/linkando-lead).
# Nunca ligue em produção.
LEAD_DRY_RUN=
LEAD_DRY_RUN_DIR=
