# Copie para .env.local e preencha.
#
# Chat de atendimento (/api/chat). Ordem de uso:
#   1. Gemini, plano GRATUITO do Google AI Studio (aistudio.google.com → Get API key)
#   2. Claude, opcional (console.anthropic.com → API Keys)
#   3. nenhuma chave → o chat responde com o script offline
# Atenção: no plano gratuito o Google pode usar as conversas para melhorar os
# produtos dele. Para dados de clientes sensíveis, use o plano pago.
GEMINI_API_KEY=
# modelo principal (cai para gemini-3.6-flash se demorar ou a cota acabar)
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# E-mail do briefing (/briefing). Caixa da Hostinger: hPanel → E-mails →
# contato@linkandodesign.com. A senha é a da caixa de e-mail.
# Todo envio sai com assunto "[Site] …", que o filtro do webmail usa para
# mover a mensagem para a pasta "Site".
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@linkandodesign.com
SMTP_PASS=
# destino do briefing (padrão: o próprio SMTP_USER)
MAIL_TO=contato@linkandodesign.com
